---
import { localize } from "../data/i18n";
import { bookingUrl, homePaths, hotel, type Language, type LocalizedPaths } from '../data/hotel';
interface Props { lang: Language; paths: LocalizedPaths; home?: boolean; }
const { lang, paths, home = false } = Astro.props;
---
    <a class="skip-link" href="#contenido">{lang === 'es' ? 'Ir al contenido' : localize(lang, 'Skip to content')}</a>
    <div class="announcement">
      <div class="container">
        <span>Kepler 147 · Verónica Anzúres · {lang === 'es' ? 'Ciudad de México' : localize(lang, 'Mexico City')}</span
        ><span
          ><a href={`tel:${hotel.telephone}`}
            >{lang === 'es' ? 'Reservaciones' : localize(lang, 'Reservations')}&nbsp;+52&nbsp;55&nbsp;3666&nbsp;8535</a
          ></span
        >
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a
          href={home ? "#inicio" : `${homePaths[lang]}#inicio`}
          class="brand"
          aria-label="Business Suites Kepler"
          ><img class="brand-logo" src="/assets/logo-kepler-header.webp" alt="SK" width="313" height="269" decoding="async" />
          <span class="brand-name"
            ><small>Business Suites</small><b>Kepler</b></span
          ></a
        ><button
          type="button"
          class="menu-button"
          aria-controls="menu"
          aria-expanded="false"
        >
          {lang === 'es' ? 'Menú' : localize(lang, 'Menu')}
        </button>
        <nav id="menu" class="nav" aria-label={lang === 'es' ? 'Navegación principal' : localize(lang, 'Main navigation')}>
          <a href={home ? "#concepto" : `${homePaths[lang]}#concepto`}>{lang === 'es' ? 'El concepto' : localize(lang, 'Our concept')}</a><a href={home ? "#suites" : `${homePaths[lang]}#suites`}>{localize(lang, 'Suites')}</a
          ><a href={home ? "#servicios" : `${homePaths[lang]}#servicios`}>{lang === 'es' ? 'Servicios' : localize(lang, 'Amenities')}</a><a href={home ? "#ubicacion" : `${homePaths[lang]}#ubicacion`}>{lang === 'es' ? 'Ubicación' : localize(lang, 'Location')}</a
          ><a
            class="nav-cta"
            href={bookingUrl(lang)}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={lang === 'es' ? 'Reservar ahora (se abre en una pestaña nueva)' : localize(lang, 'Book now (opens in a new tab)')}
            >{lang === 'es' ? 'Reservar ahora' : localize(lang, 'Book now')} ↗</a
          >
        </nav>
        <div class="language-switch" aria-label={lang === 'es' ? 'Idioma' : localize(lang, 'Language')}>
          <a href={paths.es} lang="es" hreflang="es" aria-label="Español" aria-current={lang === 'es' ? 'page' : undefined}>ES</a>
          <a href={paths.en} lang="en" hreflang="en" aria-label="English" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
          <a href={paths.zh} lang="zh-Hans" hreflang="zh-Hans" aria-label="简体中文" aria-current={lang === 'zh' ? 'page' : undefined}>中文</a>
        </div>
      </div>
    </header>
