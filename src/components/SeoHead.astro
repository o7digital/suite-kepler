---
import { absoluteUrl, type Language, type LocalizedPaths } from '../data/hotel';
interface Props {
  lang: Language;
  paths: LocalizedPaths;
  title: string;
  description: string;
  image?: string;
  structuredData?: Record<string, unknown>;
}
const { lang, paths, title, description, image = '/assets/grand-suite-four.webp', structuredData } = Astro.props;
const canonical = absoluteUrl(paths[lang]);
const json = structuredData ? JSON.stringify(structuredData).replace(/</g, '\\u003c') : undefined;
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='5' fill='%230e305d'/%3E%3Cpath d='M18 12v40M20 33 46 12M26 29l22 23' fill='none' stroke='%23c5a476' stroke-width='4.5' stroke-linecap='square'/%3E%3C/svg%3E";
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0e305d" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="icon" type="image/svg+xml" href={favicon} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="es" href={absoluteUrl(paths.es)} />
<link rel="alternate" hreflang="en" href={absoluteUrl(paths.en)} />
<link rel="alternate" hreflang="zh-Hans" href={absoluteUrl(paths.zh)} />
<link rel="alternate" hreflang="x-default" href={absoluteUrl(paths.es)} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Business Suites Kepler" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={absoluteUrl(image)} />
<meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : lang === 'es' ? 'es_MX' : 'en_US'} />
{(['es', 'en', 'zh'] as const).filter(locale => locale !== lang).map(locale => <meta property="og:locale:alternate" content={{ es: 'es_MX', en: 'en_US', zh: 'zh_CN' }[locale]} />)}
<meta name="twitter:card" content="summary_large_image" />
{json && <script is:inline type="application/ld+json" set:html={json} />}
