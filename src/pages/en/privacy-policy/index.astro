    <header class="site-header">
      <div class="container header-inner">
        <a
          href="/en/#inicio"
          class="brand"
          aria-label="Business Suites Kepler"
          ><span class="brand-mark">K</span
          ><span class="brand-name"
            ><small>Business Suites</small><b>Kepler</b></span
          ></a
        ><button
          type="button"
          class="menu-button"
          aria-controls="menu"
          aria-expanded="false"
        >
          Menu
        </button>
        <nav id="menu" class="nav" aria-label="Main navigation">
          <a href="/en/#concepto">Our concept</a><a href="/en/#suites">Suites</a
