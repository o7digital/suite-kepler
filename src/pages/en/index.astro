---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SeoHead from '../../components/SeoHead.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { homePaths, hotelSchema } from '../../data/hotel';
import { rooms } from '../../data/rooms';
const lang = 'en' as const;
const paths = homePaths;
---
<SiteLayout lang="en">
  <Fragment slot="head">
    <SeoHead lang={lang} paths={paths} title="Suites near Polanco, Mexico City | Business Suites Kepler" description="Rooms and suites with kitchens in Verónica Anzúres, near Polanco, Mexico City. Discover Grand Suite, King and Queen accommodation and book online." structuredData={hotelSchema(lang)} />
    <link
      rel="preload"
      as="image"
      href="/assets/grand-suite-four.webp"
      imagesrcset="/assets/grand-suite-four-768.webp 768w, /assets/grand-suite-four.webp 1501w"
      imagesizes="(max-width: 680px) 100vw, 57vw"
      type="image/webp"
      fetchpriority="high"
    />
  </Fragment>
    <SiteHeader lang={lang} paths={paths} home />
    <main id="contenido" tabindex="-1">
      <section class="hero" id="inicio">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker">Business Suites Kepler · Mexico City</p>
            <h1>Suites<br />near <em>Polanco.</em></h1>
            <p class="hero-lead">
              Rooms and suites in Verónica Anzúres, two blocks from Liverpool Polanco. Apartment comfort with hotel services in Mexico City.
            </p>
            <a class="arrow-link" href="#suites"
              >Discover our suites <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="hero-photo">
            <picture>
              <source
                type="image/webp"
                srcset="
                  /assets/grand-suite-four-768.webp  768w,
                  /assets/grand-suite-four.webp     1501w
                "
                sizes="(max-width: 680px) 100vw, 57vw"
              />
              <img
                src="/assets/grand-suite-four.webp"
                alt="Living and dining area in a Grand Suite at Business Suites Kepler"
                width="1501"
                height="1000"
                fetchpriority="high"
              />
            </picture>
            <span class="hero-vertical">Verónica Anzúres · Polanco</span
            ><span class="photo-note">Grand Suite · Business Suites Kepler</span>
          </div>
        </div>
      </section>
      <section class="reservation" aria-label="Reservations">
        <div class="container reservation-inner">
          <div class="reservation-text">
            <span class="reservation-symbol" aria-hidden="true">K.</span>
            <div>
              <strong>The city awaits.</strong>
              <p>Check dates, rates and availability in real time.</p>
            </div>
          </div>
          <a
            class="button"
            href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Check availability (opens in a new tab)"
            >Check availability <span aria-hidden="true">↗</span></a
          >
        </div>
      </section>
      <section class="intro" id="concepto">
        <div class="container intro-grid">
          <div>
            <p class="section-label">01 / The Business Suites Kepler experience</p>
            <h2 class="display">
              Your stay in <em>Mexico City.</em>
            </h2>
          </div>
          <div class="intro-right">
            <p>
              Two blocks from Liverpool Polanco, Business Suites Kepler combines the privacy of an apartment with the services of a hotel, in an ideal location for business or leisure.
            </p>
            <p>
              Stay a few days in a welcoming room or settle into a Grand Suite with a living room, dining area and kitchen. Find the space that suits your stay.
            </p>
            <div class="stat-line">
              <b>13</b
              ><span>rooms and suites<br />to find your perfect stay</span>
            </div>
          </div>
        </div>
      </section>
      <section class="rooms" id="suites">
        <div class="container">
          <div class="rooms-head">
            <div>
              <p class="section-label">02 / Our spaces</p>
              <h2 class="display">Suites and rooms<br /><em>in Verónica Anzúres.</em></h2>
            </div>
            <p>
              Rooms with all the essentials. Suites that invite you to stay a little longer.
            </p>
          </div>
          <article class="featured">
            <div class="featured-image">
              <img
                src="/assets/grand-suite-two.webp"
                alt="Spacious living and dining area in a Grand Suite"
                loading="lazy"
                width="1334"
                height="1000"
              /><span>Photo of the property</span>
            </div>
            <div class="featured-copy">
              <p class="section-label">Our most spacious suite</p>
              <h3><a href={rooms[0].paths[lang]}>Grand<br />Suite.</a></h3>
              <p>
                Your own temporary address in the city. An equipped kitchen, living room and dining area to spend time together, work in peace or stay a little longer.
              </p>
              <div class="featured-facts">
                <span>80–95 m²</span><span>Two beds</span
                ><span>Kitchen and living room</span>
              </div>
              <div class="room-actions">
                <a class="arrow-link" href={rooms[0].paths[lang]}>View Grand Suite <span aria-hidden="true">↗</span></a>
                <a
                class="arrow-link"
                href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Check Grand Suite availability (opens in a new tab)"
                >Check availability <span aria-hidden="true">↗</span></a
              >
              </div>
            </div>
          </article>
          <div class="room-pair">
            <article>
              <div class="image">
                <img
                  src="/assets/king.webp"
                  alt="King room with bed and desk"
                  loading="lazy"
                  width="1439"
                  height="942"
                />
              </div>
              <div class="content">
                <span class="meta">30 m² / King bed</span>
                <h3><a href={rooms[1].paths[lang]}>King Room</a></h3>
                <p>
                  Space to rest or work, with a balcony and access to a kitchenette outside the room.
                </p>
                <div class="room-actions">
                <a class="arrow-link" href={rooms[1].paths[lang]}>View King Room <span aria-hidden="true">↗</span></a>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explore King Room availability (opens in a new tab)"
                  >Explore availability <span aria-hidden="true">↗</span></a
                >
              </div>
              </div>
            </article>
            <article>
              <div class="image">
                <img
                  src="/assets/queen.webp"
                  alt="Queen room with bed and workspace"
                  loading="lazy"
                  width="1334"
                  height="1000"
                />
              </div>
              <div class="content">
                <span class="meta">27 m² / Queen bed</span>
                <h3><a href={rooms[2].paths[lang]}>Queen Room</a></h3>
                <p>
                  A calm, practical space with a desk, private bathroom and everything you need to enjoy the city.
                </p>
                <div class="room-actions">
                <a class="arrow-link" href={rooms[2].paths[lang]}>View Queen Room <span aria-hidden="true">↗</span></a>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explore Queen Room availability (opens in a new tab)"
                  >Explore availability <span aria-hidden="true">↗</span></a
                >
              </div>
              </div>
            </article>
          </div>
        </div>
      </section>
      <section class="experience" id="servicios">
        <div class="container experience-grid">
          <div class="experience-images">
            <img
              class="primary"
              src="/assets/grand-suite.webp"
              alt="Dining table in a Grand Suite"
              loading="lazy"
              width="667"
              height="1000"
            /><img
              class="secondary"
              src="/assets/patio.webp"
              alt="Private patio in a Grand Suite"
              loading="lazy"
              width="750"
              height="1000"
            />
          </div>
          <div class="experience-copy">
            <p class="section-label">03 / Designed for your stay</p>
            <h2 class="display">
              The little details <em>make the difference.</em>
            </h2>
            <p>
              A place you look forward to coming back to at the end of the day. The comfort of settling in freely, with services to support your stay.
            </p>
            <div class="service-list">
              <span>In-room Wi-Fi</span><span>Daily housekeeping</span
              ><span>Space to work</span><span>Safety deposit box</span
              ><span>Limited parking</span
              ><span>Invoices available</span>
            </div>
          </div>
        </div>
      </section>
      <section class="location" id="ubicacion">
        <div class="container location-grid">
          <div class="location-copy">
            <p class="section-label">04 / The neighborhood</p>
            <h2 class="display">Verónica Anzúres,<br /><em>near Polanco.</em></h2>
            <p>
              In Verónica Anzúres, two blocks from Liverpool Polanco, you will have a convenient base for exploring Mexico City.
            </p>
            <div class="location-address">
              Kepler 147, Verónica Anzúres<br />Miguel Hidalgo, Mexico City
              11590
            </div>
            <a
              class="arrow-link"
              href="https://www.google.com/maps/search/?api=1&query=Kepler+147%2C+Ver%C3%B3nica+Anz%C3%BAres%2C+Ciudad+de+M%C3%A9xico"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Get directions (opens in a new tab)"
              >Get directions <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="location-image">
            <img
              src="/assets/fachada.webp"
              alt="Exterior of Business Suites Kepler"
              loading="lazy"
              width="700"
              height="490"
            /><span>Kepler 147 / CDMX</span>
          </div>
        </div>
      </section>
      <section class="final-cta">
        <p class="section-label">Business Suites Kepler</p>
        <h2>Your next stay<br />starts here.</h2>
        <a
          class="button"
          href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Book online (opens in a new tab)"
          >Book online <span aria-hidden="true">↗</span></a
        >
      </section>
    </main>
    <SiteFooter lang={lang} home />
  
</SiteLayout>
