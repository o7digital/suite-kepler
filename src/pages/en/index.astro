---
import SiteLayout from '../../layouts/SiteLayout.astro';
---
<SiteLayout lang="en">
  <Fragment slot="head">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e305d" />
    <meta
      name="description"
      content="Business Suites Kepler: rooms and Grand Suites in Verónica Anzúres, two blocks from Polanco. Check availability and book online."
    />
    <title>Business Suites Kepler — Suites in Mexico City</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='5' fill='%230e305d'/%3E%3Cpath d='M18 12v40M20 33 46 12M26 29l22 23' fill='none' stroke='%23c5a476' stroke-width='4.5' stroke-linecap='square'/%3E%3C/svg%3E"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/grand-suite-four.webp"
      imagesrcset="/assets/grand-suite-four-768.webp 768w, /assets/grand-suite-four.webp 1501w"
      imagesizes="(max-width: 680px) 100vw, 57vw"
      type="image/webp"
      fetchpriority="high"
    />
    <link rel="canonical" href="https://www.businesssuiteskepler.com/en/" />
    <link rel="alternate" hreflang="es" href="https://www.businesssuiteskepler.com/" />
    <link rel="alternate" hreflang="en" href="https://www.businesssuiteskepler.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://www.businesssuiteskepler.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Business Suites Kepler" />
    <meta property="og:title" content="Business Suites Kepler — Hotel in Mexico City" />
    <meta property="og:url" content="https://www.businesssuiteskepler.com/en/" />
    <meta property="og:image" content="https://www.businesssuiteskepler.com/assets/grand-suite-four.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json">{"@context": "https://schema.org", "@type": "Hotel", "name": "Business Suites Kepler", "url": "https://www.businesssuiteskepler.com/", "image": "https://www.businesssuiteskepler.com/assets/fachada.webp"}</script>
  
  </Fragment>
    <a class="skip-link" href="#contenido">Skip to content</a>
    <div class="announcement">
      <div class="container">
        <span>Kepler 147 · Verónica Anzúres · Mexico City</span
        ><span
          ><a href="tel:+525536668535"
            >Reservations&nbsp;+52&nbsp;55&nbsp;3666&nbsp;8535</a
          ></span
        >
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a
          href="#inicio"
          class="brand"
          aria-label="Business Suites Kepler"
          ><span class="brand-mark">K</span
          ><span class="brand-name"
            ><small>Business Suites</small><b>Kepler</b></span
          ></a
        ><button
          type="button"
          class="menu-button"
          aria-controls="menu"
          aria-expanded="false"
        >
          Menu
        </button>
        <nav id="menu" class="nav" aria-label="Main navigation">
          <a href="#concepto">Our concept</a><a href="#suites">Suites</a
          ><a href="#servicios">Amenities</a><a href="#ubicacion">Location</a
          ><a
            class="nav-cta"
            href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Book now (opens in a new tab)"
            >Book now ↗</a
          >
        </nav>
        <div class="language-switch" aria-label="Language">
          <a href="/" lang="es" hreflang="es" aria-label="Español">ES</a>
          <a href="/en/" lang="en" hreflang="en" aria-label="English" aria-current="page">EN</a>
        </div>
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <section class="hero" id="inicio">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker">Business Suites Kepler · Mexico City</p>
            <h1>A place<br />to <em>stay.</em></h1>
            <p class="hero-lead">
              The freedom of feeling at home, with the care of a hotel stay. Discover a space to experience the city your way.
            </p>
            <a class="arrow-link" href="#suites"
              >Discover our suites <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="hero-photo">
            <picture>
              <source
                type="image/webp"
                srcset="
                  /assets/grand-suite-four-768.webp  768w,
                  /assets/grand-suite-four.webp     1501w
                "
                sizes="(max-width: 680px) 100vw, 57vw"
              />
              <img
                src="/assets/grand-suite-four.webp"
                alt="Living and dining area in a Grand Suite at Business Suites Kepler"
                width="1501"
                height="1000"
                fetchpriority="high"
              />
            </picture>
            <span class="hero-vertical">Verónica Anzúres · Polanco</span
            ><span class="photo-note">Grand Suite · Business Suites Kepler</span>
          </div>
        </div>
      </section>
      <section class="reservation" aria-label="Reservations">
        <div class="container reservation-inner">
          <div class="reservation-text">
            <span class="reservation-symbol" aria-hidden="true">K.</span>
            <div>
              <strong>The city awaits.</strong>
              <p>Check dates, rates and availability in real time.</p>
            </div>
          </div>
          <a
            class="button"
            href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Check availability (opens in a new tab)"
            >Check availability <span aria-hidden="true">↗</span></a
          >
        </div>
      </section>
      <section class="intro" id="concepto">
        <div class="container intro-grid">
          <div>
            <p class="section-label">01 / The Business Suites Kepler experience</p>
            <h2 class="display">
              Your own way to <em>feel at home in the city.</em>
            </h2>
          </div>
          <div class="intro-right">
            <p>
              Two blocks from Liverpool Polanco, Business Suites Kepler combines the privacy of an apartment with the services of a hotel, in an ideal location for business or leisure.
            </p>
            <p>
              Stay a few days in a welcoming room or settle into a Grand Suite with a living room, dining area and kitchen. Find the space that suits your stay.
            </p>
            <div class="stat-line">
              <b>13</b
              ><span>rooms and suites<br />to find your perfect stay</span>
            </div>
          </div>
        </div>
      </section>
      <section class="rooms" id="suites">
        <div class="container">
          <div class="rooms-head">
            <div>
              <p class="section-label">02 / Our spaces</p>
              <h2 class="display">Stay your way.</h2>
            </div>
            <p>
              Rooms with all the essentials. Suites that invite you to stay a little longer.
            </p>
          </div>
          <article class="featured">
            <div class="featured-image">
              <img
                src="/assets/grand-suite-two.webp"
                alt="Spacious living and dining area in a Grand Suite"
                loading="lazy"
                width="1334"
                height="1000"
              /><span>Photo of the property</span>
            </div>
            <div class="featured-copy">
              <p class="section-label">Our most spacious suite</p>
              <h3>Grand<br />Suite.</h3>
              <p>
                Your own temporary address in the city. An equipped kitchen, living room and dining area to spend time together, work in peace or stay a little longer.
              </p>
              <div class="featured-facts">
                <span>80–95 m²</span><span>Two beds</span
                ><span>Kitchen and living room</span>
              </div>
              <a
                class="arrow-link"
                href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Check Grand Suite availability (opens in a new tab)"
                >Check availability <span aria-hidden="true">↗</span></a
              >
            </div>
          </article>
          <div class="room-pair">
            <article>
              <div class="image">
                <img
                  src="/assets/king.webp"
                  alt="King room with bed and desk"
                  loading="lazy"
                  width="1439"
                  height="942"
                />
              </div>
              <div class="content">
                <span class="meta">30 m² / King bed</span>
                <h3>King Room</h3>
                <p>
                  Space to rest or work, with a balcony and access to a kitchenette outside the room.
                </p>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explore King Room availability (opens in a new tab)"
                  >Explore availability <span aria-hidden="true">↗</span></a
                >
              </div>
            </article>
            <article>
              <div class="image">
                <img
                  src="/assets/queen.webp"
                  alt="Queen room with bed and workspace"
                  loading="lazy"
                  width="1334"
                  height="1000"
                />
              </div>
              <div class="content">
                <span class="meta">27 m² / Queen bed</span>
                <h3>Queen Room</h3>
                <p>
                  A calm, practical space with a desk, private bathroom and everything you need to enjoy the city.
                </p>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explore Queen Room availability (opens in a new tab)"
                  >Explore availability <span aria-hidden="true">↗</span></a
                >
              </div>
            </article>
          </div>
        </div>
      </section>
      <section class="experience" id="servicios">
        <div class="container experience-grid">
          <div class="experience-images">
            <img
              class="primary"
              src="/assets/grand-suite.webp"
              alt="Dining table in a Grand Suite"
              loading="lazy"
              width="667"
              height="1000"
            /><img
              class="secondary"
              src="/assets/patio.webp"
              alt="Private patio in a Grand Suite"
              loading="lazy"
              width="750"
              height="1000"
            />
          </div>
          <div class="experience-copy">
            <p class="section-label">03 / Designed for your stay</p>
            <h2 class="display">
              The little details <em>make the difference.</em>
            </h2>
            <p>
              A place you look forward to coming back to at the end of the day. The comfort of settling in freely, with services to support your stay.
            </p>
            <div class="service-list">
              <span>In-room Wi-Fi</span><span>Daily housekeeping</span
              ><span>Space to work</span><span>Safety deposit box</span
              ><span>Limited parking</span
              ><span>Invoices available</span>
            </div>
          </div>
        </div>
      </section>
      <section class="location" id="ubicacion">
        <div class="container location-grid">
          <div class="location-copy">
            <p class="section-label">04 / The neighborhood</p>
            <h2 class="display">Everything nearby.<br /><em>Time for yourself.</em></h2>
            <p>
              In Verónica Anzúres, two blocks from Liverpool Polanco, you will have a convenient base for exploring Mexico City.
            </p>
            <div class="location-address">
              Kepler 147, Verónica Anzúres<br />Miguel Hidalgo, Mexico City
              11590
            </div>
            <a
              class="arrow-link"
              href="https://www.google.com/maps/search/?api=1&query=Kepler+147%2C+Ver%C3%B3nica+Anz%C3%BAres%2C+Ciudad+de+M%C3%A9xico"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Get directions (opens in a new tab)"
              >Get directions <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="location-image">
            <img
              src="/assets/fachada.webp"
              alt="Exterior of Business Suites Kepler"
              loading="lazy"
              width="700"
              height="490"
            /><span>Kepler 147 / CDMX</span>
          </div>
        </div>
      </section>
      <section class="final-cta">
        <p class="section-label">Business Suites Kepler</p>
        <h2>Your next stay<br />starts here.</h2>
        <a
          class="button"
          href="https://hotels.cloudbeds.com/en/reservation/lSYkcf?currency=mxn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Book online (opens in a new tab)"
          >Book online <span aria-hidden="true">↗</span></a
        >
      </section>
    </main>
    <footer class="footer">
      <div class="container">
        <div class="footer-top">
          <a
            href="#inicio"
            class="brand"
          aria-label="Business Suites Kepler"
            ><span class="brand-mark">K</span
            ><span class="brand-name"
              ><small>Business Suites</small><b>Kepler</b></span
            ></a
          >
          <div class="footer-links">
            <a href="/en/privacy-policy/">Privacy notice</a>
            <a href="tel:+525536668535">+52&nbsp;55&nbsp;3666&nbsp;8535</a
            ><a href="mailto:reservaskepler@gmail.com"
              >reservaskepler@gmail.com</a
            ><a href="#ubicacion">Kepler 147, Mexico City</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© Business Suites Kepler</span
          ><span
            >Rates, terms and availability are subject to the booking engine.</span
          >
        </div>
      </div>
    </footer>
  
</SiteLayout>
