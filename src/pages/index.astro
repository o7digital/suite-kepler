---
import SiteLayout from '../layouts/SiteLayout.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { homePaths, hotelSchema } from '../data/hotel';
import { rooms } from '../data/rooms';
const lang = 'es' as const;
const paths = homePaths;
---
<SiteLayout lang="es">
  <Fragment slot="head">
    <SeoHead lang={lang} paths={paths} title="Suites cerca de Polanco, CDMX | Business Suites Kepler" description="Suites en Verónica Anzúres, cerca de Polanco y Liverpool, CDMX. Alojamiento ejecutivo con Wi-Fi y limpieza diaria; Grand Suites con cocina equipada." structuredData={hotelSchema(lang)} />
    <link
      rel="preload"
      as="image"
      href="/assets/grand-suite-four.webp"
      imagesrcset="/assets/grand-suite-four-768.webp 768w, /assets/grand-suite-four.webp 1501w"
      imagesizes="(max-width: 680px) 100vw, 57vw"
      type="image/webp"
      fetchpriority="high"
    />
  </Fragment>
    <SiteHeader lang={lang} paths={paths} home />
    <main id="contenido" tabindex="-1">
      <section class="hero" id="inicio">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker">Business Suites Kepler · Ciudad de México</p>
            <h1>Suites<br />cerca de <em>Polanco.</em></h1>
            <p class="hero-lead">
              Habitaciones y suites en Verónica Anzúres, a dos calles de Liverpool Polanco. La comodidad de un departamento con servicios de hotel en Ciudad de México.
            </p>
            <a class="arrow-link" href="#suites"
              >Descubre nuestras suites <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="hero-photo">
            <picture>
              <source
                type="image/webp"
                srcset="
                  /assets/grand-suite-four-768.webp  768w,
                  /assets/grand-suite-four.webp     1501w
                "
                sizes="(max-width: 680px) 100vw, 57vw"
              />
              <img
                src="/assets/grand-suite-four.webp"
                alt="Sala y comedor de una Grand Suite en Business Suites Kepler"
                width="1501"
                height="1000"
                fetchpriority="high"
              />
            </picture>
            <span class="hero-vertical">Verónica Anzúres · Polanco</span
            ><span class="photo-note">Grand Suite · Business Suites Kepler</span>
          </div>
        </div>
      </section>
      <section class="reservation" aria-label="Reservación">
        <div class="container reservation-inner">
          <div class="reservation-text">
            <span class="reservation-symbol" aria-hidden="true">K.</span>
            <div>
              <strong>La ciudad te espera.</strong>
              <p>Consulta fechas, tarifas y disponibilidad en tiempo real.</p>
            </div>
          </div>
          <a
            class="button"
            href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Consultar disponibilidad (se abre en una pestaña nueva)"
            >Consultar disponibilidad <span aria-hidden="true">↗</span></a
          >
        </div>
      </section>
      <section class="intro" id="concepto">
        <div class="container intro-grid">
          <div>
            <p class="section-label">01 / La experiencia Business Suites Kepler</p>
            <h2 class="display">
              Alojamiento ejecutivo<br /><em>en Anzúres.</em>
            </h2>
          </div>
          <div class="intro-right">
            <p>
              A dos calles de Liverpool Polanco, Business Suites Kepler reúne la
              privacidad de un departamento y los servicios de un hotel en Verónica
              Anzúres, Miguel Hidalgo. Un alojamiento para viajes de negocios
              en CDMX, con Wi-Fi, limpieza diaria y facturación disponible.
            </p>
            <p>
              Quédate unos días en una habitación acogedora o instala tu rutina
              en una Grand Suite con sala, comedor y cocina. Cada estancia tiene
              el espacio que necesita.
            </p>
            <div class="stat-line">
              <b>13</b
              ><span>habitaciones y suites<br />para elegir tu estancia</span>
            </div>
          </div>
        </div>
      </section>
      <section class="rooms" id="suites">
        <div class="container">
          <div class="rooms-head">
            <div>
              <p class="section-label">02 / Los espacios</p>
              <h2 class="display">Suites y habitaciones<br /><em>en Verónica Anzúres.</em></h2>
            </div>
            <p>
              Habitaciones para lo esencial. Suites para dejar que la estancia
              se extienda.
            </p>
          </div>
          <article class="featured">
            <div class="featured-image">
              <img
                src="/assets/grand-suite-two.webp"
                alt="Amplia sala y comedor de una Grand Suite"
                loading="lazy"
                width="1334"
                height="1000"
              /><span>Fotografía de la propiedad</span>
            </div>
            <div class="featured-copy">
              <p class="section-label">Nuestra suite más amplia</p>
              <h3><a href={rooms[0].paths[lang]}>Grand<br />Suite.</a></h3>
              <p>
                Tu propia dirección temporal en la ciudad. Cocina equipada, sala
                y comedor para compartir el día, trabajar con calma o quedarte
                un poco más.
              </p>
              <div class="featured-facts">
                <span>80–95 m²</span><span>Dos camas</span
                ><span>Cocina y sala</span>
              </div>
              <div class="room-actions">
                <a class="arrow-link" href={rooms[0].paths[lang]}>Ver Grand Suite <span aria-hidden="true">↗</span></a>
                <a
                class="arrow-link"
                href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Consultar disponibilidad de Grand Suite (se abre en una pestaña nueva)"
                >Consultar disponibilidad <span aria-hidden="true">↗</span></a
              >
              </div>
            </div>
          </article>
          <div class="room-pair">
            <article>
              <div class="image">
                <img
                  src="/assets/king.webp"
                  alt="Habitación King con cama y escritorio"
                  loading="lazy"
                  width="1439"
                  height="942"
                />
              </div>
              <div class="content">
                <span class="meta">30 m² / Cama King</span>
                <h3><a href={rooms[1].paths[lang]}>Habitación King</a></h3>
                <p>
                  Amplitud para descansar o trabajar, con balcón y acceso a una
                  cocineta fuera de la habitación.
                </p>
                <div class="room-actions">
                <a class="arrow-link" href={rooms[1].paths[lang]}>Ver Habitación King <span aria-hidden="true">↗</span></a>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explorar disponibilidad de Habitación King (se abre en una pestaña nueva)"
                  >Explorar disponibilidad <span aria-hidden="true">↗</span></a
                >
              </div>
              </div>
            </article>
            <article>
              <div class="image">
                <img
                  src="/assets/queen.webp"
                  alt="Habitación Queen con cama y área de trabajo"
                  loading="lazy"
                  width="1334"
                  height="1000"
                />
              </div>
              <div class="content">
                <span class="meta">27 m² / Cama Queen</span>
                <h3><a href={rooms[2].paths[lang]}>Habitación Queen</a></h3>
                <p>
                  Un espacio sereno y funcional con escritorio, baño privado y
                  lo esencial para disfrutar la ciudad.
                </p>
                <div class="room-actions">
                <a class="arrow-link" href={rooms[2].paths[lang]}>Ver Habitación Queen <span aria-hidden="true">↗</span></a>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explorar disponibilidad de Habitación Queen (se abre en una pestaña nueva)"
                  >Explorar disponibilidad <span aria-hidden="true">↗</span></a
                >
              </div>
              </div>
            </article>
          </div>
        </div>
      </section>
      <section class="experience" id="servicios">
        <div class="container experience-grid">
          <div class="experience-images">
            <img
              class="primary"
              src="/assets/grand-suite.webp"
              alt="Mesa de comedor de una Grand Suite"
              loading="lazy"
              width="667"
              height="1000"
            /><img
              class="secondary"
              src="/assets/patio.webp"
              alt="Patio privado en una Grand Suite"
              loading="lazy"
              width="750"
              height="1000"
            />
          </div>
          <div class="experience-copy">
            <p class="section-label">03 / Pensado para tu estancia</p>
            <h2 class="display">
              Los pequeños detalles <em>hacen el lugar.</em>
            </h2>
            <p>
              Un espacio al que quieres volver al terminar el día. La comodidad
              de instalarte con libertad, con servicios que acompañan tu
              estancia.
            </p>
            <div class="service-list">
              <span>Wi-Fi en las habitaciones</span><span>Limpieza diaria</span
              ><span>Espacio para trabajar</span><span>Caja de seguridad</span
              ><span>Estacionamiento limitado</span
              ><span>Facturación disponible</span>
            </div>
          </div>
        </div>
      </section>
      <section class="location" id="ubicacion">
        <div class="container location-grid">
          <div class="location-copy">
            <p class="section-label">04 / El entorno</p>
            <h2 class="display">Verónica Anzúres,<br /><em>cerca de Polanco.</em></h2>
            <p>
              En Verónica Anzúres, a dos calles de Liverpool Polanco, tendrás un
              punto de partida práctico para recorrer Ciudad de México. Consulta
              nuestra ubicación para planear visitas a Mariano Escobedo,
              Torre Pemex en Marina Nacional y los museos de Chapultepec.
            </p>
            <p><a class="arrow-link" href="/ubicacion/">Explorar la ubicación y los alrededores <span aria-hidden="true">↗</span></a></p>
            <div class="location-address">
              Kepler 147, Verónica Anzúres<br />Miguel Hidalgo, Ciudad de México
              11590
            </div>
            <a
              class="arrow-link"
              href="https://www.google.com/maps/search/?api=1&query=Kepler+147%2C+Ver%C3%B3nica+Anz%C3%BAres%2C+Ciudad+de+M%C3%A9xico"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Ver cómo llegar (se abre en una pestaña nueva)"
              >Ver cómo llegar <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="location-image">
            <img
              src="/assets/fachada.webp"
              alt="Fachada de Business Suites Kepler"
              loading="lazy"
              width="700"
              height="490"
            /><span>Kepler 147 / CDMX</span>
          </div>
        </div>
      </section>
      <section class="final-cta">
        <p class="section-label">Business Suites Kepler</p>
        <h2>Tu próxima estancia<br />empieza aquí.</h2>
        <a
          class="button"
          href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Reservar en línea (se abre en una pestaña nueva)"
          >Reservar en línea <span aria-hidden="true">↗</span></a
        >
      </section>
    </main>
    <SiteFooter lang={lang} home />
  
</SiteLayout>
