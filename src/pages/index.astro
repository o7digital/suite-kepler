---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout lang="es">
  <Fragment slot="head">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0e305d" />
    <meta
      name="description"
      content="Business Suites Kepler: habitaciones y Grand Suites en Verónica Anzúres, a dos calles de Polanco. Consulta disponibilidad y reserva en línea."
    />
    <title>Business Suites Kepler — Suites en Ciudad de México</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='5' fill='%230e305d'/%3E%3Cpath d='M18 12v40M20 33 46 12M26 29l22 23' fill='none' stroke='%23c5a476' stroke-width='4.5' stroke-linecap='square'/%3E%3C/svg%3E"
    />
    <link
      rel="preload"
      as="image"
      href="/assets/grand-suite-four.webp"
      imagesrcset="/assets/grand-suite-four-768.webp 768w, /assets/grand-suite-four.webp 1501w"
      imagesizes="(max-width: 680px) 100vw, 57vw"
      type="image/webp"
      fetchpriority="high"
    />
    <link rel="canonical" href="https://www.businesssuiteskepler.com/" />
    <link rel="alternate" hreflang="es" href="https://www.businesssuiteskepler.com/" />
    <link rel="alternate" hreflang="en" href="https://www.businesssuiteskepler.com/en/" />
    <link rel="alternate" hreflang="x-default" href="https://www.businesssuiteskepler.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Business Suites Kepler" />
    <meta property="og:title" content="Business Suites Kepler — Hotel en Ciudad de México" />
    <meta property="og:url" content="https://www.businesssuiteskepler.com/" />
    <meta property="og:image" content="https://www.businesssuiteskepler.com/assets/grand-suite-four.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json">{"@context": "https://schema.org", "@type": "Hotel", "name": "Business Suites Kepler", "url": "https://www.businesssuiteskepler.com/", "image": "https://www.businesssuiteskepler.com/assets/fachada.webp"}</script>
  
  </Fragment>
    <a class="skip-link" href="#contenido">Ir al contenido</a>
    <div class="announcement">
      <div class="container">
        <span>Kepler 147 · Verónica Anzúres · Ciudad de México</span
        ><span
          ><a href="tel:+525536668535"
            >Reservaciones&nbsp;+52&nbsp;55&nbsp;3666&nbsp;8535</a
          ></span
        >
      </div>
    </div>
    <header class="site-header">
      <div class="container header-inner">
        <a
          href="#inicio"
          class="brand"
          aria-label="Business Suites Kepler"
          ><span class="brand-mark">K</span
          ><span class="brand-name"
            ><small>Business Suites</small><b>Kepler</b></span
          ></a
        ><button
          type="button"
          class="menu-button"
          aria-controls="menu"
          aria-expanded="false"
        >
          Menú
        </button>
        <nav id="menu" class="nav" aria-label="Navegación principal">
          <a href="#concepto">El concepto</a><a href="#suites">Suites</a
          ><a href="#servicios">Servicios</a><a href="#ubicacion">Ubicación</a
          ><a
            class="nav-cta"
            href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Reservar ahora (se abre en una pestaña nueva)"
            >Reservar ahora ↗</a
          >
        </nav>
        <div class="language-switch" aria-label="Idioma">
          <a href="/" lang="es" hreflang="es" aria-label="Español" aria-current="page">ES</a>
          <a href="/en/" lang="en" hreflang="en" aria-label="English">EN</a>
        </div>
      </div>
    </header>
    <main id="contenido" tabindex="-1">
      <section class="hero" id="inicio">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-kicker">Business Suites Kepler · Ciudad de México</p>
            <h1>Un lugar<br />para <em>quedarte.</em></h1>
            <p class="hero-lead">
              La libertad de sentirte en casa, con el cuidado de una estancia de
              hotel. Descubre un espacio para vivir la ciudad a tu manera.
            </p>
            <a class="arrow-link" href="#suites"
              >Descubre nuestras suites <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="hero-photo">
            <picture>
              <source
                type="image/webp"
                srcset="
                  /assets/grand-suite-four-768.webp  768w,
                  /assets/grand-suite-four.webp     1501w
                "
                sizes="(max-width: 680px) 100vw, 57vw"
              />
              <img
                src="/assets/grand-suite-four.webp"
                alt="Sala y comedor de una Grand Suite en Business Suites Kepler"
                width="1501"
                height="1000"
                fetchpriority="high"
              />
            </picture>
            <span class="hero-vertical">Verónica Anzúres · Polanco</span
            ><span class="photo-note">Grand Suite · Business Suites Kepler</span>
          </div>
        </div>
      </section>
      <section class="reservation" aria-label="Reservación">
        <div class="container reservation-inner">
          <div class="reservation-text">
            <span class="reservation-symbol" aria-hidden="true">K.</span>
            <div>
              <strong>La ciudad te espera.</strong>
              <p>Consulta fechas, tarifas y disponibilidad en tiempo real.</p>
            </div>
          </div>
          <a
            class="button"
            href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Consultar disponibilidad (se abre en una pestaña nueva)"
            >Consultar disponibilidad <span aria-hidden="true">↗</span></a
          >
        </div>
      </section>
      <section class="intro" id="concepto">
        <div class="container intro-grid">
          <div>
            <p class="section-label">01 / La experiencia Business Suites Kepler</p>
            <h2 class="display">
              Tu propia forma de <em>estar en la ciudad.</em>
            </h2>
          </div>
          <div class="intro-right">
            <p>
              A dos calles de Liverpool Polanco, Business Suites Kepler reúne la
              privacidad de un departamento y los servicios de un hotel en una
              ubicación ideal para viajes de trabajo o de placer.
            </p>
            <p>
              Quédate unos días en una habitación acogedora o instala tu rutina
              en una Grand Suite con sala, comedor y cocina. Cada estancia tiene
              el espacio que necesita.
            </p>
            <div class="stat-line">
              <b>13</b
              ><span>habitaciones y suites<br />para elegir tu estancia</span>
            </div>
          </div>
        </div>
      </section>
      <section class="rooms" id="suites">
        <div class="container">
          <div class="rooms-head">
            <div>
              <p class="section-label">02 / Los espacios</p>
              <h2 class="display">Quédate a tu manera.</h2>
            </div>
            <p>
              Habitaciones para lo esencial. Suites para dejar que la estancia
              se extienda.
            </p>
          </div>
          <article class="featured">
            <div class="featured-image">
              <img
                src="/assets/grand-suite-two.webp"
                alt="Amplia sala y comedor de una Grand Suite"
                loading="lazy"
                width="1334"
                height="1000"
              /><span>Fotografía de la propiedad</span>
            </div>
            <div class="featured-copy">
              <p class="section-label">Nuestra suite más amplia</p>
              <h3>Grand<br />Suite.</h3>
              <p>
                Tu propia dirección temporal en la ciudad. Cocina equipada, sala
                y comedor para compartir el día, trabajar con calma o quedarte
                un poco más.
              </p>
              <div class="featured-facts">
                <span>80–95 m²</span><span>Dos camas</span
                ><span>Cocina y sala</span>
              </div>
              <a
                class="arrow-link"
                href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Consultar disponibilidad de Grand Suite (se abre en una pestaña nueva)"
                >Consultar disponibilidad <span aria-hidden="true">↗</span></a
              >
            </div>
          </article>
          <div class="room-pair">
            <article>
              <div class="image">
                <img
                  src="/assets/king.webp"
                  alt="Habitación King con cama y escritorio"
                  loading="lazy"
                  width="1439"
                  height="942"
                />
              </div>
              <div class="content">
                <span class="meta">30 m² / Cama King</span>
                <h3>Habitación King</h3>
                <p>
                  Amplitud para descansar o trabajar, con balcón y acceso a una
                  cocineta fuera de la habitación.
                </p>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explorar disponibilidad de Habitación King (se abre en una pestaña nueva)"
                  >Explorar disponibilidad <span aria-hidden="true">↗</span></a
                >
              </div>
            </article>
            <article>
              <div class="image">
                <img
                  src="/assets/queen.webp"
                  alt="Habitación Queen con cama y área de trabajo"
                  loading="lazy"
                  width="1334"
                  height="1000"
                />
              </div>
              <div class="content">
                <span class="meta">27 m² / Cama Queen</span>
                <h3>Habitación Queen</h3>
                <p>
                  Un espacio sereno y funcional con escritorio, baño privado y
                  lo esencial para disfrutar la ciudad.
                </p>
                <a
                  class="arrow-link"
                  href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Explorar disponibilidad de Habitación Queen (se abre en una pestaña nueva)"
                  >Explorar disponibilidad <span aria-hidden="true">↗</span></a
                >
              </div>
            </article>
          </div>
        </div>
      </section>
      <section class="experience" id="servicios">
        <div class="container experience-grid">
          <div class="experience-images">
            <img
              class="primary"
              src="/assets/grand-suite.webp"
              alt="Mesa de comedor de una Grand Suite"
              loading="lazy"
              width="667"
              height="1000"
            /><img
              class="secondary"
              src="/assets/patio.webp"
              alt="Patio privado en una Grand Suite"
              loading="lazy"
              width="750"
              height="1000"
            />
          </div>
          <div class="experience-copy">
            <p class="section-label">03 / Pensado para tu estancia</p>
            <h2 class="display">
              Los pequeños detalles <em>hacen el lugar.</em>
            </h2>
            <p>
              Un espacio al que quieres volver al terminar el día. La comodidad
              de instalarte con libertad, con servicios que acompañan tu
              estancia.
            </p>
            <div class="service-list">
              <span>Wi-Fi en las habitaciones</span><span>Limpieza diaria</span
              ><span>Espacio para trabajar</span><span>Caja de seguridad</span
              ><span>Estacionamiento limitado</span
              ><span>Facturación disponible</span>
            </div>
          </div>
        </div>
      </section>
      <section class="location" id="ubicacion">
        <div class="container location-grid">
          <div class="location-copy">
            <p class="section-label">04 / El entorno</p>
            <h2 class="display">Todo cerca.<br /><em>Tiempo para ti.</em></h2>
            <p>
              En Verónica Anzúres, a dos calles de Liverpool Polanco, tendrás un
              punto de partida práctico para recorrer Ciudad de México.
            </p>
            <div class="location-address">
              Kepler 147, Verónica Anzúres<br />Miguel Hidalgo, Ciudad de México
              11590
            </div>
            <a
              class="arrow-link"
              href="https://www.google.com/maps/search/?api=1&query=Kepler+147%2C+Ver%C3%B3nica+Anz%C3%BAres%2C+Ciudad+de+M%C3%A9xico"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Ver cómo llegar (se abre en una pestaña nueva)"
              >Ver cómo llegar <span aria-hidden="true">↗</span></a
            >
          </div>
          <div class="location-image">
            <img
              src="/assets/fachada.webp"
              alt="Fachada de Business Suites Kepler"
              loading="lazy"
              width="700"
              height="490"
            /><span>Kepler 147 / CDMX</span>
          </div>
        </div>
      </section>
      <section class="final-cta">
        <p class="section-label">Business Suites Kepler</p>
        <h2>Tu próxima estancia<br />empieza aquí.</h2>
        <a
          class="button"
          href="https://hotels.cloudbeds.com/es/reservation/lSYkcf?currency=mxn"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Reservar en línea (se abre en una pestaña nueva)"
          >Reservar en línea <span aria-hidden="true">↗</span></a
        >
      </section>
    </main>
    <footer class="footer">
      <div class="container">
        <div class="footer-top">
          <a
            href="#inicio"
            class="brand"
          aria-label="Business Suites Kepler"
            ><span class="brand-mark">K</span
            ><span class="brand-name"
              ><small>Business Suites</small><b>Kepler</b></span
            ></a
          >
          <div class="footer-links">
            <a href="/privacy-policy/">Aviso de privacidad</a>
            <a href="tel:+525536668535">+52&nbsp;55&nbsp;3666&nbsp;8535</a
            ><a href="mailto:reservaskepler@gmail.com"
              >reservaskepler@gmail.com</a
            ><a href="#ubicacion">Kepler 147, Ciudad de México</a>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© Business Suites Kepler</span
          ><span
            >Tarifas, condiciones y disponibilidad sujetas al motor de
            reservas.</span
          >
        </div>
      </div>
    </footer>
  
</SiteLayout>
