---
import OliviaAI from '../components/OliviaAI.astro';
import Analytics from '../components/Analytics.astro';
import NavigationScript from '../components/NavigationScript.astro';
import '../styles/site.css';
const { lang = 'es' } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <slot />
    <NavigationScript />
    <OliviaAI lang={lang} />
  </body>
</html>
