---
import SiteLayout from './SiteLayout.astro';
import SeoHead from '../components/SeoHead.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { bookingUrl, hotelSchema, locationPaths, mapUrl, type Language } from '../data/hotel';
import { rooms } from '../data/rooms';
const { lang } = Astro.props as { lang: Language };
const es = lang === 'es';
const sections = es ? [
  { title: 'Suites en Verónica Anzúres, cerca de Polanco.', text: 'Business Suites Kepler está en Kepler 147, colonia Verónica Anzúres, alcaldía Miguel Hidalgo, Ciudad de México. Si buscas un hotel en Anzúres o un apart hotel cerca de Polanco, aquí puedes elegir entre habitaciones King y Queen y Grand Suites con cocina equipada. La propiedad está en Verónica Anzúres; Polanco es una referencia cercana.' },
  { title: 'Liverpool Polanco y Mariano Escobedo.', text: 'Para quienes buscan suites cerca de Liverpool Polanco, la propiedad se encuentra a dos calles de la tienda. Liverpool está en Calzada General Mariano Escobedo 425. Esta referencia permite ubicar tu hospedaje cerca de Mariano Escobedo en CDMX y organizar tus actividades en la zona.', source: 'https://assetspwa.liverpool.com.mx/assets/digital/mailings/html/2019/directorio_BX/index.html', label: 'Consultar el directorio de Liverpool' },
  { title: 'Viajes de trabajo: Torre Pemex y Marina Nacional.', text: 'Si tu viaje incluye una visita a las oficinas de Pemex, la Torre Ejecutiva está en Marina Nacional 329, colonia Verónica Anzúres. Puedes considerar Business Suites Kepler como alojamiento ejecutivo en la zona y consultar la ruta desde Kepler 147 antes de tu cita. Las habitaciones cuentan con Wi-Fi, espacio para trabajar y facturación disponible.', source: 'https://www.pemex.com/bienes-no-utiles/enajenacion/Paginas/contacto.aspx', label: 'Consultar la dirección oficial de Pemex' },
  { title: 'Visitar Chapultepec y sus museos.', text: 'Además de tu viaje de negocios, puedes planear una visita al Museo Tamayo, en Paseo de la Reforma 51, o al Museo Nacional de Antropología, en el entorno de Reforma y Calzada Gandhi. Ambos forman parte del recorrido cultural de Chapultepec. Revisa los horarios en sus sitios oficiales y consulta la ruta desde el hotel antes de salir.', source: 'https://www.museotamayo.org/visita', label: 'Planear la visita al Museo Tamayo' },
] : [
  { title: 'Suites in Verónica Anzúres, near Polanco.', text: 'Business Suites Kepler is at Kepler 147, in Verónica Anzúres, Miguel Hidalgo, Mexico City. Choose a King Room, a Queen Room or a Grand Suite with an equipped kitchen for your stay near Polanco. The property is in Verónica Anzúres, with Polanco nearby.' },
  { title: 'Liverpool Polanco and Mariano Escobedo.', text: 'The property is two blocks from Liverpool Polanco, at Calzada General Mariano Escobedo 425. Use this landmark to locate your accommodation near Mariano Escobedo in Mexico City and plan your activities in the area.', source: 'https://assetspwa.liverpool.com.mx/assets/digital/mailings/html/2019/directorio_BX/index.html', label: 'View the Liverpool directory' },
  { title: 'Business trips: Pemex Tower and Marina Nacional.', text: 'If your trip includes a visit to the Pemex offices, the Executive Tower is at Marina Nacional 329, in Verónica Anzúres. Consider Business Suites Kepler as a base in the neighborhood and check your route from Kepler 147 before your appointment. Rooms offer Wi-Fi, space to work and invoices on request.', source: 'https://www.pemex.com/bienes-no-utiles/enajenacion/Paginas/contacto.aspx', label: 'Check the official Pemex address' },
  { title: 'Explore Chapultepec and its museums.', text: 'Plan a visit to Museo Tamayo, at Paseo de la Reforma 51, or the National Museum of Anthropology, around Reforma and Calzada Gandhi. Both are part of the Chapultepec cultural area. Check opening hours on their official websites and your route from the hotel before setting out.', source: 'https://www.museotamayo.org/visita', label: 'Plan your Museo Tamayo visit' },
];
---
<SiteLayout lang={lang}>
  <Fragment slot="head">
    <SeoHead lang={lang} paths={locationPaths}
      title={es ? 'Hotel en Verónica Anzúres, cerca de Polanco | Ubicación Kepler' : 'Hotel in Verónica Anzúres, near Polanco | Kepler location'}
      description={es ? 'Business Suites Kepler en Kepler 147, Verónica Anzúres, CDMX. Ubica Liverpool Polanco, Mariano Escobedo, Torre Pemex y los museos de Chapultepec.' : 'Find Business Suites Kepler at Kepler 147, Verónica Anzúres, Mexico City. Plan visits to Liverpool Polanco, Pemex Tower and the Chapultepec museums.'}
      image="/assets/fachada.webp" structuredData={hotelSchema(lang)} />
  </Fragment>
  <SiteHeader lang={lang} paths={locationPaths} />
  <main id="contenido" tabindex="-1">
    <section class="hero" id="inicio">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-kicker">Kepler 147 · Miguel Hidalgo · CDMX</p>
          <h1>{es ? 'En Anzúres,' : 'In Anzúres,'}<br /><em>{es ? 'cerca de Polanco.' : 'near Polanco.'}</em></h1>
          <p class="hero-lead">{es ? 'Ubica tu estancia en Ciudad de México: nuestra dirección, referencias del barrio y lugares para organizar tu viaje de trabajo o de placer.' : 'Find your base in Mexico City: our address, neighborhood landmarks and places to plan your business or leisure trip.'}</p>
          <a class="arrow-link" href={mapUrl} target="_blank" rel="noopener noreferrer">{es ? 'Ver cómo llegar' : 'Get directions'} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-photo">
          <img src="/assets/fachada.webp" alt={es ? 'Fachada de Business Suites Kepler en Kepler 147' : 'Business Suites Kepler facade at Kepler 147'} width="700" height="490" fetchpriority="high" />
          <span class="photo-note">Kepler 147 · Verónica Anzúres</span>
        </div>
      </div>
    </section>
    <section class="intro" id="ubicacion">
      <div class="container intro-grid">
        <div>
          <p class="section-label">{es ? 'Dirección y alrededores' : 'Address and surroundings'}</p>
          <h2 class="display">Kepler 147.</h2>
          <p>Verónica Anzúres<br />Miguel Hidalgo, {es ? 'Ciudad de México' : 'Mexico City'} 11590</p>
        </div>
        <div class="intro-right">
          {sections.map(section => <section class="area">
            <h2>{section.title}</h2><p>{section.text}</p>
            {section.source && <a href={section.source} target="_blank" rel="noopener noreferrer">{section.label} ↗</a>}
          </section>)}
          <a href="https://mna.inah.gob.mx/" target="_blank" rel="noopener noreferrer">{es ? 'Sitio oficial del Museo Nacional de Antropología' : 'Official National Museum of Anthropology website'} ↗</a>
        </div>
      </div>
    </section>
    <section class="rooms" id="suites">
      <div class="container">
        <p class="section-label">{es ? 'Elige tu alojamiento' : 'Choose your accommodation'}</p>
        <h2 class="display">{es ? 'Habitaciones y suites en Anzúres.' : 'Rooms and suites in Anzúres.'}</h2>
        <p class="stay-copy">{es ? 'Para estancias largas cerca de Polanco, la Grand Suite ofrece cocina dentro de la suite, sala y comedor. King cuenta con balcón y acceso a cocineta exterior; Queen ofrece escritorio y baño privado. Consulta disponibilidad y condiciones para tus fechas.' : 'For longer stays near Polanco, the Grand Suite offers an indoor kitchen and living and dining areas. King has a balcony and access to an external kitchenette; Queen offers a desk and private bathroom. Check availability and terms for your dates.'}</p>
        <div class="room-links">{rooms.map(room => <a class="arrow-link" href={room.paths[lang]}>{room[lang].name} ↗</a>)}</div>
      </div>
    </section>
    <section class="final-cta">
      <p class="section-label">Business Suites Kepler</p>
      <h2>{es ? 'Reserva tu estancia.' : 'Book your stay.'}</h2>
      <a class="button" href={bookingUrl(lang)} target="_blank" rel="noopener noreferrer">{es ? 'Consultar disponibilidad' : 'Check availability'} ↗</a>
    </section>
  </main>
  <SiteFooter lang={lang} />
</SiteLayout>
<style>
  .area { margin-bottom: 2.5rem; }
  .area h2 { font-size: 1.6rem; line-height: 1.3; margin-bottom: 1rem; }
  .area a { text-underline-offset: .2em; }
  .stay-copy { max-width: 760px; margin: 1.5rem 0; }
  .room-links { display: flex; flex-wrap: wrap; gap: 1.5rem; }
</style>
